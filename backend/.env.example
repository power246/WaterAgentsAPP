WATERAGENTS_DB_HOST='127.0.0.1'
WATERAGENTS_DB_PORT='5432'
WATERAGENTS_DB_NAME='wateragents'
WATERAGENTS_DB_USER='wateragents'
WATERAGENTS_DB_PASSWORD='replace-with-a-local-password'
WATERAGENTS_DB_SSLMODE='disable'
# WATERAGENTS_DB_SSLROOTCERT='/path/to/provider-ca.pem'

WATERAGENTS_MODEL_CATALOG='[{"provider":"openai","model":"replace-with-parser-model","roles":["query_parser"]},{"provider":"openai","model":"replace-with-waterbody-model","roles":["waterbody"]}]'
WATERAGENTS_OPENAI_API_KEY='replace-with-openai-api-key'
WATERAGENTS_OPENAI_BASE_URL='https://api.openai.com/v1'
WATERAGENTS_GOOGLE_GEOCODING_API_KEY='replace-with-google-geocoding-api-key'
# WATERAGENTS_USGS_API_KEY='replace-with-optional-usgs-api-key'
WATERAGENTS_TOPOLOGY_MAX_DISTANCE_KM='100'
WATERAGENTS_TOPOLOGY_MAX_HOPS='12'
WATERAGENTS_TOPOLOGY_MAX_NODES='128'
WATERAGENTS_TOPOLOGY_MAX_CONCURRENCY='8'
WATERAGENTS_PREDICTION_BASELINE_HOURS='48'
WATERAGENTS_MAX_TARGET_PARAMETERS='6'
WATERAGENTS_QUERY_PARSER_TIMEOUT_SECONDS='45'
WATERAGENTS_TOPOLOGY_STAGE_TIMEOUT_SECONDS='120'
WATERAGENTS_REASONING_MAX_PLANNING_TURNS='6'
WATERAGENTS_REASONING_MAX_TOOL_CALLS_PER_TURN='4'
WATERAGENTS_REASONING_MAX_CELLS_PER_BATCH='32'
WATERAGENTS_REASONING_MAX_BATCHES='24'
WATERAGENTS_REASONING_MODEL_TIMEOUT_SECONDS='90'
WATERAGENTS_REASONING_SESSION_DEADLINE_SECONDS='600'

# WATERAGENTS_TEST_DB_NAME is test-only.
# Set it in the test process environment; do not add it to backend/.env.
